    "grounding_techniques": [
        {
            "name": "5-4-3-2-1 Technique",
            "steps": [
                "Acknowledge 5 things you see around you.",
                "Acknowledge 4 things you can touch around you.",
                "Acknowledge 3 things you hear.",
                "Acknowledge 2 things you can smell.",
                "Acknowledge 1 thing you can taste."
            ]
        },
        {
            "name": "Box Breathing",
            "steps": [
                "Inhale for 4 seconds.",
                "Hold for 4 seconds.",
                "Exhale for 4 seconds.",
                "Hold for 4 seconds."
            ]
        },
        {
            "name": "Categories Game",
            "steps": [
                "Choose a category (e.g., Movies, Animals, Colors).",
                "Name as many items in that category as you can for 1 minute.",
                "This engages your thinking brain and calms emotions."
            ]
        },
        {
            "name": "Cold Water Shock",
            "steps": [
                "Splash cold water on your face.",
                "Or hold an ice cube in your hand until it melts.",
                "This activates the mammalian dive reflex to slow your heart rate."
            ]
        }
    ],
    "faq": {
        "finding_therapist": "You can find a therapist through online directories like Psychology Today, or by asking your primary care doctor for a referral. Many insurance companies also have lists of covered providers.",
        "cost": "Therapy costs vary widely. Some offer sliding scales based on income. Community health centers often provide lower-cost options.",
        "medication": "Medication is a decision to be made with a psychiatrist or doctor. It can be very helpful for many people in managing symptoms.",
        "hotlines": "If you are in crisis, please call 988 (USA) for the Suicide & Crisis Lifeline, or text HOME to 741741 for the Crisis Text Line.",
        "types_of_therapy": "There are many types! CBT focuses on thoughts, DBT on emotions and relationships, and Somatic therapy on the body. It helps to research which might fit your needs.",
        "first_session": "In the first session, the therapist typically asks about your history, current symptoms, and goals. It's a 'get-to-know-you' meeting to see if it's a good fit.",
        "insurance": "Many insurance plans cover therapy, but coverage varies. Contact your provider to ask about 'outpatient mental health benefits' and copays.",
        "helping_friend": "Listen without judgment. validations like 'That sounds really hard' help more than advice. Encourage them to seek professional help if needed."
    },
    "wellness_modules": {
        "sleep": {
            "description": "Sleep is crucial for mental and emotional resilience.",
            "tips": [
                "Stick to a consistent sleep schedule, even on weekends.",
                "Create a relaxing bedtime routine (reading, warm bath).",
                "Limit screen time an hour before bed.",
                "Keep your bedroom cool, dark, and quiet.",
                "Avoid caffeine and heavy meals close to bedtime."
            ],
            "warning_signs": "Chronic insomnia or oversleeping can indicate depression or anxiety."
        },
        "diet": {
            "description": "Nutrition directly affects brain function and mood.",
            "tips": [
                "Eat regular meals to maintain blood sugar levels.",
                "Include Omega-3 fatty acids (fish, flaxseed) for brain health.",
                "Stay hydrated; dehydration can affect concentration.",
                "Limit processed foods and sugary snacks.",
                "Balance caffeine and alcohol intake."
            ],
            "warning_signs": "Loss of appetite or overeating can be stress responses."
        },
        "exercise": {
            "description": "Physical activity releases endorphins, natural mood lifters.",
            "tips": [
                "Aim for 30 minutes of moderate activity most days.",
                "Find an activity you enjoy (walking, dancing, swimming).",
                "Exercise outdoors to get fresh air and sunlight.",
                "Start small; even 10 minutes helps.",
                "Yoga can combine movement with mindfulness."
            ],
            "warning_signs": "Lack of energy to move or excessive exercise can be concerning."
        },
        "social": {
            "description": "Social connections provide support and reduce isolation.",
            "tips": [
                "Schedule regular catch-ups with friends/family.",
                "Join a club or group with shared interests.",
                "Volunteer to connect with your community.",
                "Set boundaries if relationships are draining.",
                "It's okay to say no to social events if you need rest."
            ],
            "warning_signs": "Social withdrawal is a common symptom of depression and anxiety."
        }
    },
    "coping_strategies_extended": {
        "breathing_exercises": [
            {
                "name": "4-7-8 Breathing",
                "instruction": "Inhale for 4s, hold for 7s, exhale for 8s. Repeat 4 times."
            },
            {
                "name": "Box Breathing",
                "instruction": "Inhale 4s, hold 4s, exhale 4s, hold 4s. Good for panic."
            },
            {
                "name": "Diaphragmatic Breathing",
                "instruction": "Breathe deep into your belly, not chest. Hand on stomach should rise."
            }
        ],
        "mindfulness": [
            {
                "name": "Senses Check",
                "instruction": "Notice 5 things you see, 4 feel, 3 hear, 2 smell, 1 taste."
            },
            {
                "name": "Body Scan",
                "instruction": "Mentally scan body from toes to head, releasing tension in each part."
            },
            {
                "name": "Mindful Walking",
                "instruction": "Focus entirely on the sensation of your feet touching the ground."
            }
        ],
        "journaling_prompts": [
            "What is bothering me right now?",
            "List 3 things I am grateful for today.",
            "Write a letter to yourself from a compassionate friend's perspective.",
            "What is the worst case, best case, and most likely outcome?"
        ],
        "cbt_exercises": [
            {
                "name": "Thought Record",
                "instruction": "Identify the situation, emotion, negative thought, evidence for/against, and a balanced thought."
            },
            {
                "name": "Behavioral Activation",
                "instruction": "Plan and do a small enjoyable activity even if you don't feel like it."
            }
        ],
        "crisis_protocols": {
            "suicide_risk": "Immediate escalation. Provide lifelines. Do not leave user (simulated).",
            "self_harm": "Harm reduction advice. Suggest holding ice cubes or snapping a rubber band instead.",
            "severe_anxiety": "Direct guidance to breathing/grounding. distinct short commands."
        }
